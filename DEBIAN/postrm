#!/bin/bash
set -e
APPID="dufs"
if [ "$1" = "purge" ]; then
    systemctl stop "dufs.service" 2>/dev/null || true
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/dufs /etc/dufs /usr/local/dufs 2>/dev/null || true
    rm -f /etc/systemd/system/dufs.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
